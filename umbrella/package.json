{
  "name": "@molcrafts/molvis",
  "version": "0.1.1",
  "type": "module",
  "description": "MolVis umbrella: 2D sketch + 3D stage",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./sketch": {
      "types": "./dist/sketch.d.ts",
      "import": "./dist/sketch.js",
      "default": "./src/sketch.ts"
    },
    "./stage": {
      "types": "./dist/stage.d.ts",
      "import": "./dist/stage.js",
      "default": "./src/stage.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rslib build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@molcrafts/molvis-sketch": "*",
    "@molcrafts/molvis-stage": "*"
  },
  "devDependencies": {
    "@rslib/core": "^0.22.0",
    "typescript": "^6.0.3"
  },
  "author": "Roy Kid",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MolCrafts/molvis.git",
    "directory": "umbrella"
  }
}

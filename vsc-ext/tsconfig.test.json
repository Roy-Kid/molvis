{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "module": "Node16",
    "moduleResolution": "Node16",
    "ignoreDeprecations": "6.0",
    "rootDir": ".",
    "outDir": "out-test",
    "sourceMap": false,
    "declaration": false,
    "types": ["node", "mocha", "vscode"]
  },
  "include": [
    "tests/**/*.ts",
    "src/protocol/**/*.ts",
    "src/webview/applySettings.ts",
    "src/webview/mol_v2000.ts",
    "src/extension/types.ts",
    "src/extension/panels/panelRegistry.ts",
    "src/extension/loading/zarrDirectoryReaderCore.ts",
    "src/extension/loading/pathUtils.ts",
    "src/extension/loading/filesTree.ts",
    "src/extension/loading/molecularMatch.ts",
    "src/extension/loading/formatMenu.ts",
    "src/extension/loading/fileRangeReader.ts",
    "src/webview/hostRangeSource.ts",
    "src/webview/sketchOutline.ts",
    "src/protocol/messages.ts"
  ],
  "exclude": [
    "tests/unit/loading/molecularLoadIntent.test.ts",
    "tests/unit/loading/remoteMolrsIndexer.test.ts",
    "tests/unit/loading/remoteIndexStore.test.ts"
  ]
}

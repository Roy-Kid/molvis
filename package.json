{
  "name": "molvis",
  "version": "0.2.0",
  "description": "Interactive molecular visualization for web, VS Code, and Python",
  "author": "Roy Kid",
  "license": "BSD-3-Clause",
  "workspaces": [
    "core",
    "stage",
    "sketch",
    "umbrella",
    "page",
    "vsc-ext"
  ],
  "scripts": {
    "dev:core": "npm run typecheck -w @molcrafts/molvis-core",
    "dev:stage": "npm run dev -w @molcrafts/molvis-stage",
    "dev:sketch": "npm run dev -w @molcrafts/molvis-sketch",
    "dev:page": "npm run dev -w page",
    "dev:python": "npm run dev:python -w page",
    "build:core": "npm run build -w @molcrafts/molvis-core",
    "build:stage": "npm run build -w @molcrafts/molvis-stage",
    "build:sketch": "npm run build -w @molcrafts/molvis-sketch",
    "build:umbrella": "npm run build -w @molcrafts/molvis",
    "build:page": "npm run build -w page && rm -rf python/src/molvis/dist && mkdir -p python/src/molvis/dist && cp -r page/dist/. python/src/molvis/dist/",
    "build:vsc-ext": "npm run build -w vsc-ext",
    "build:all": "npm run build:core && npm run build:stage && npm run build:sketch && npm run build:umbrella && npm run build:page && npm run build:vsc-ext",
    "build:python": "npm run build:page",
    "build:standalone": "npm run build:page",
    "typecheck:core": "npm run typecheck -w @molcrafts/molvis-core",
    "typecheck:stage": "npm run typecheck -w @molcrafts/molvis-stage",
    "typecheck:sketch": "npm run typecheck -w @molcrafts/molvis-sketch",
    "typecheck:page": "npm run typecheck -w page",
    "typecheck:vsc-ext": "npm run typecheck -w vsc-ext",
    "typecheck": "npm run typecheck:core && npm run typecheck:stage && npm run typecheck:sketch && npm run typecheck:page && npm run typecheck:vsc-ext",
    "test:core": "npm run test -w @molcrafts/molvis-core",
    "test:stage": "npm run test -w @molcrafts/molvis-stage",
    "test:sketch": "npm run test -w @molcrafts/molvis-sketch",
    "test:headless": "npm run test:headless -w @molcrafts/molvis-stage",
    "test:page": "npm run test -w page",
    "test:python": "cd python && if [ -x .venv/bin/python ]; then .venv/bin/python -m pytest tests; else python3 -m pytest tests; fi",
    "test:vsc-ext": "npm run test:unit -w vsc-ext",
    "test:regressions": "npm run test:regressions -w @molcrafts/molvis-stage",
    "test:e2e": "rstest run -c e2e/rstest.config.ts",
    "test": "npm run test:core && npm run test:stage && npm run test:sketch && npm run test:page && npm run test:python && npm run test:vsc-ext",
    "test:watch": "npm run test:watch -w @molcrafts/molvis-stage",
    "release:stage:check": "npm run release:check -w @molcrafts/molvis-stage",
    "check:pack": "npm run check:pack -w @molcrafts/molvis-stage",
    "lint": "biome check --write",
    "check:molrs-gateway": "node scripts/check-molrs-gateway.mjs",
    "sync:plugin-contract": "node scripts/sync-plugin-contract.mjs",
    "check:plugin-contract": "node scripts/sync-plugin-contract.mjs --check",
    "version:sync": "node scripts/sync-version.mjs",
    "prepare": "node scripts/sync-version.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@rsbuild/core": "^2.0.8",
    "@rslib/core": "^0.22.0",
    "@rstest/browser": "^0.11.6",
    "@rstest/core": "^0.11.6",
    "@rstest/playwright": "^0.11.6",
    "concurrently": "^10.0.0",
    "playwright": "^1.60.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.13.0",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@molcrafts/molplot": "^0.1.1",
    "@molcrafts/molrs": "^0.12.0",
    "vega": "^5.30.0",
    "vega-embed": "^6.29.0",
    "vega-lite": "^5.21.0"
  },
  "overrides": {
    "@rspack/core": "^2.0.5",
    "@rsbuild/core": "^2.0.8",
    "@rslib/core": "^0.22.0",
    "@rsbuild/plugin-react": "^2.0.0",
    "@rstest/core": "^0.11.6",
    "@rstest/browser": "^0.11.6",
    "@rstest/playwright": "^0.11.6"
  },
  "packageManager": "npm@11.16.0"
}
